[FORMAT]
max-line-length = 120
indent-string = '    '

[TYPECHECK]
ignore-missing-imports = true
follow-imports = skip

[DESIGN]
max-args = 7
max-locals = 15
max-returns = 6
max-branches = 12
max-statements = 50
max-parents = 7
max-attributes = 7
min-public-methods = 1

[SIMILARITIES]
min-similarity-lines = 4
ignore-comments = yes
ignore-docstrings = yes
ignore-imports = no

[LOGGING]
logging-modules = logging
logging-level = INFO